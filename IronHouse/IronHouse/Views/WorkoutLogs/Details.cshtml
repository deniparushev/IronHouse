@model IronHouse.Models.WorkoutLog

@{
    ViewData["Title"] = "Workout Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Workout Details</h2>
    <a asp-controller="SetLogs" asp-action="Create" asp-route-workoutLogId="@Model.Id" class="btn btn-success">+ Add Set</a>
</div>

<dl class="row bg-light p-3 rounded">
    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-3">Workout Type</dt>
    <dd class="col-sm-9">@Model.WorkoutType</dd>

    <dt class="col-sm-3">Duration</dt>
    <dd class="col-sm-9">@Model.Duration minutes</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@(Model.Notes ?? "No notes provided.")</dd>
</dl>

<h3 class="mt-4">Recorded Sets</h3>
@if (Model.SetLogs.Any())
{
    <table class="table table-bordered mt-2">
        <thead class="table-secondary">
            <tr>
                <th>Exercise</th>
                <th>Weight (kg)</th>
                <th>Reps</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var set in Model.SetLogs)
            {
                <tr>
                    <td>@(set.Exercise?.Name ?? "Unknown")</td>
                    <td>@set.WeightKg kg</td>
                    <td>@set.Reps</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No sets added to this workout yet.</p>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit Workout</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>